# Production settings. Set these as environment variables on your host
# (don't commit real values). See DEPLOYMENT.md for details.

APP_NAME=Codingsols
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://codingsols.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL (most hosts give you these, or a single DB_URL)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DB_URL=postgresql://user:password@host:5432/database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Email through Resend (https://resend.com). The from address must be on a
# domain you've verified in Resend.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@codingsols.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Search (database driver needs no extra service)
SCOUT_DRIVER=database

# Optional: Cloudflare Turnstile on sign-up and contact. Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
